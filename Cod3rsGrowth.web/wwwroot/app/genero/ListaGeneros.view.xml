<mvc:View xmlns:cards="sap.f.cards"
	controllerName="ui5.anime.app.genero.ListaGeneros"
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:l="sap.ui.layout"
	>
	<Page 
		id = "pagina"
		title="{i18n>listaDeGeneroTitulo}" 
		class="sapUiResponsiveContentPadding"
		showNavButton="true"
        navButtonPress="aoClicarEmVoltarParaListaAnime" 
		titleAlignment="Center">	
		<content>
				<List items = "{path: 'generos>/'}" class= "listaDeGeneros" id = "listaDeGeneros" growing="true" growingThreshold="10">
					<headerToolbar >
						<Toolbar class="sapUiResponsiveMargin">
							<ToolbarSpacer/>
							<Button text="{i18n>btnAdicionarGenero}" press="aoClicarAdicionarGenero" id= "btnAdicionar" class = "sapMBtnInner"></Button>
							<SearchField
								id = "CampoDeBusca" 
								width="30%" 
								liveChange="aoFiltrarGenero"
								placeholder="{i18n>placeholderPesquisa}"
							/>
						</Toolbar>
					</headerToolbar>
					<CustomListItem id = "listaDosGeneros" class = "sapUiTinyMarginTopBottom" type="Navigation" press="aoClicarNoGenero" >
						<HBox class= "sapUiResponsiveMargin">						
							<VBox class="vBoxGenero" width="30%">
								<ObjectStatus text="{generos>nome}" class="sapUiLargeMarginEnd sapUiTinyMarginBegin sapThemeFont" />
			                </VBox>
						</HBox>							
					</CustomListItem>
				</List>
		</content>
	</Page>
</mvc:View>