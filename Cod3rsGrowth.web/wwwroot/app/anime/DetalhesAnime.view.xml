<mvc:View xmlns:tnt="sap.tnt" xmlns:smartmultiedit="sap.ui.comp.smartmultiedit" xmlns:macros="sap.fe.macros" 
    xmlns:layout="sap.ui.layout" 
    controllerName="ui5.anime.app.anime.DetalhesAnime"
    displayBlock="true"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    >
    <Page title="{i18n>TituloPaginaDetalhesAnime}" class="sapUiResponsiveContentPadding"
        id = "pagina"
        showNavButton="true"
        navButtonPress="aoClicarEmVoltarParaListaAnime"
        titleAlignment="Center"
    >
    <Toolbar design="Transparent">
        <ToolbarSpacer/>
            <Button id = "btnEditar" text="Editar" class="sapMBtnInner" width="8%" press= "aoClicarEmEditar" ></Button>
            <Button id = "btnRemover" text="Remover" class="sapMBtnInner" width="8%" press= "aoClicarEmRemover"></Button>
    </Toolbar>
    <content >
        <layout:VerticalLayout width="100%">
            <Label text="{i18n>labelId}" ></Label>
            <Input id= "inputId" 
                editable="false" value="{path: 'anime>/id'}" width="30%" class="sapUiTinyMarginTopBottom"></Input>
            <Label text="{i18n>labelNome}" ></Label>
            <Input id= "inputNome" 
                editable="false" value="{path: 'anime>/nome'}" width="30%" class="sapUiTinyMarginTopBottom"></Input>
            <Label text="{i18n>labelNota}"  ></Label>
            <Input id= "inputNota" 
                editable="false" value="{path: 'anime>/nota'}" width="30%"  class="sapUiTinyMarginTopBottom"></Input>
            <Label text="{i18n>labelDataLancamento}" ></Label>
            <Input id= "inputDataLancamento" 
                editable="false" value="{path: 'anime>/dataLancamento', type: 'sap.ca.ui.model.type.Date', formatOptions: {pattern: 'dd/MM/YYYY'}}" width="30%" class="sapUiTinyMarginTopBottom"></Input>
            <Label text="{i18n>labelStatusExibicao}" ></Label>
            <Input id= "inputStatusExibicao" 
                editable="false" value="{path: 'anime>/statusDeExibicao', formatter: '.formatter.enum'}" width="30%" class="sapUiTinyMarginTopBottom"></Input>
            <Label text="{i18n>labelSinopse}" ></Label>
            <TextArea id= "inputSinopse" 
                value="{path: 'anime>/sinopse'}" editable="false" width="30%" height="100px" class="sapUiTinyMarginTopBottom"></TextArea>
            <Label text="{i18n>labelGeneros}" ></Label>          
            <Panel width="30%" class="sapUiTinyMarginTopBottom">
                <List
                id ="listaDeGeneros"
                items= "{path: 'generos>/'}"
                >
                    <CustomListItem >
                    <Label text="{path: 'generos>nome'}"></Label>
                    </CustomListItem> 
            </List>
            </Panel>
        </layout:VerticalLayout>
    </content>
    </Page>
</mvc:View>